# Where the frontend looks for the backend.
#
# Local backend on your own machine:
#     VITE_API_BASE=http://localhost:8000
#
# Sushree's backend over the cloudflare tunnel (the usual case for everyone
# else). The URL is regenerated every time the tunnel restarts, so take the
# current one from the team channel -- `./tunnel.sh` prints the exact line to
# post. Vite reads this file only at startup: restart `npm run dev` after
# changing it, or the app keeps calling the old URL.
VITE_API_BASE=http://localhost:8000

# Deployed as ONE service: FastAPI serves this build, so the API is same-origin
# and every fetch should be a relative path. An empty value is deliberate --
# api.ts only falls back to http://localhost:8000 when the var is undefined.
#
# .env.local wins over this file, so local `npm run build` still points at
# 127.0.0.1:8000 for whoever has one.
VITE_API_BASE=

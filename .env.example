# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Share secrets in the team channel, not in git.

# --- database ---
# Shared Postgres with pgvector (Neon free tier). Keep ?sslmode=require.
DATABASE_URL=postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require

# --- LLM providers ---
# Active provider: glm | gemini | groq | mock
PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=glm-4-flash

# Fallbacks. Different vendors on purpose -- one outage must not take out both.
FALLBACK_API_KEY_GEMINI=
FALLBACK_MODEL_GEMINI=
FALLBACK_API_KEY_GROQ=
FALLBACK_MODEL_GROQ=
FALLBACK_MODEL_GROQ_ALTERNATIVE=

# --- translation ---
SARVAM_API_KEY=

# --- retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ALIGNMENT_REFUSAL_THRESHOLD=0.35

# Cache every LLM + translation call to disk. Keep on -- this is demo insurance.
LLM_CACHE_ENABLED=1

# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Share secrets in the team channel, not in git.

# --- database ---
# Shared Postgres with pgvector (Neon free tier). Keep ?sslmode=require.
DATABASE_URL=postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require

# --- LLM providers ---
# Active provider: groq | gemini | glm | mock
# These MUST be API model IDs, not display names. "Gemini 3.6 Flash" is not a
# model id; "gemini-3.6-flash" is. A wrong id fails with HTTP 400/404, which
# looks identical to a bad key until you read the body.
# Order below reflects measured latency - see scripts/bench_providers.py.
PROVIDER=groq

FALLBACK_API_KEY_GROQ=
FALLBACK_MODEL_GROQ=openai/gpt-oss-120b
FALLBACK_MODEL_GROQ_ALTERNATIVE=qwen/qwen3.6-27b

FALLBACK_API_KEY_GEMINI=
FALLBACK_MODEL_GEMINI=gemini-3.6-flash

GLM_API_KEY=
GLM_MODEL=glm-4.5-flash

# --- translation ---
SARVAM_API_KEY=

# --- retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Below this combined score the tutor refuses instead of answering.
# NOT a guess: embedding similarity has a high floor (unrelated text still
# scores ~0.4-0.5), so a low threshold never refuses. Calibrate against the
# real corpus with: backend/scripts/calibrate_threshold.py
ALIGNMENT_REFUSAL_THRESHOLD=0.68

# Cache every LLM + translation call to disk. Keep on -- this is demo insurance.
LLM_CACHE_ENABLED=1
